{
  "name": "campus-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs",
    "build:data": "node scripts/build-data.mjs",
    "fetch:all": "node scripts/build-data.mjs",
    "fetch:timetable": "node scripts/fetch-timetable-links.mjs",
    "fetch:timetable:download": "node scripts/fetch-timetable-links.mjs --download",
    "fetch:calendar": "node scripts/fetch-calendar.mjs",
    "fetch:exam": "node scripts/fetch-exam.mjs",
    "fetch:cafeteria": "node scripts/fetch-cafeteria.mjs",
    "parse:timetable": "node scripts/parse-pdf-timetable.mjs",
    "build:lessons": "node scripts/convert-to-lessons.mjs",
    "verify:lessons": "node scripts/verify-lessons.mjs",
    "update:timetable": "node scripts/fetch-timetable-links.mjs --download && node scripts/convert-to-lessons.mjs",
    "vendor:export": "node scripts/build-export-vendor.mjs"
  },
  "devDependencies": {
    "pdf2json": "^4.1.1",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  }
}
